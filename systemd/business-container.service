# /etc/xdg/systemd/user/business-container.service
[Unit]
Description=thin-edge Container  
After=network-online.target
Wants=network-online.target business-container-restart.path
Requires=podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/business/edge/scripts/start-business-container.sh
ExecStop=/usr/bin/podman stop -t 10 business
ExecStopPost=/usr/bin/podman rm -f business
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target